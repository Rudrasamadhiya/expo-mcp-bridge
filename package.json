{
  "name": "expo-mcp-bridge",
  "version": "0.3.1",
  "description": "Let AI agents (Claude Code, Cursor, Antigravity) see and drive your Expo / React Native app on a real phone: snapshot, tap, type, scroll, screenshots, logs and network over MCP.",
  "keywords": [
    "expo",
    "react-native",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "claude",
    "testing",
    "expo-go",
    "automation",
    "antigravity",
    "cursor",
    "claude-code",
    "react-native-testing",
    "ai-agent",
    "mcp-server",
    "mobile-testing",
    "e2e-testing",
    "ios",
    "android"
  ],
  "license": "MIT",
  "author": "Rudra Samadhiya",
  "homepage": "https://rudrasamadhiya.github.io/expo-agent-kit/docs/bridge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rudrasamadhiya/expo-mcp-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Rudrasamadhiya/expo-mcp-bridge/issues"
  },
  "main": "client/index.js",
  "react-native": "client/index.js",
  "types": "client/index.d.ts",
  "bin": {
    "expo-mcp-bridge": "server/cli.mjs"
  },
  "files": [
    "client",
    "server",
    "skill",
    "README.md",
    "LICENSE",
