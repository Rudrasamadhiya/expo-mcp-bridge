    "AI_SETUP.md"
  ],
  "scripts": {
    "test": "node --test test/e2e.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "expo-constants": "*",
    "react": "*",
    "react-native": "*",
    "react-native-view-shot": "*"
  },
  "peerDependenciesMeta": {
    "expo-constants": {
      "optional": true
    },
    "react-native-view-shot": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.1.0",
    "react-test-renderer": "^19.1.0"
